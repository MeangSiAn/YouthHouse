<?xml version="1.0" encoding="utf-8"?>
<!--
  debug 변이에서만 앱 이름을 덮어쓴다. applicationIdSuffix 덕분에 release와 나란히 깔리므로
  홈 화면에 아이콘이 두 개 뜨는데, 이름이 같으면 어느 쪽이 어느 빌드인지 알 수 없다.

  build.gradle.kts의 resValue로 하면 main의 app_name과 중복 리소스 오류가 나므로
  소스셋 오버라이드로 처리한다.
-->
<resources>
    <string name="app_name">청년의집 (D)</string>
</resources>
