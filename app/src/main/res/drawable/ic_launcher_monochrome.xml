<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 테마 아이콘용 단색 버전.

  전경을 그대로 재사용하지 않는 이유: 알림 점이 게시판 우상단 모서리와 겹쳐 있어서
  색 대비가 사라지면 두 도형이 한 덩어리로 뭉개진다. 단색에서는 점을 빼고
  게시판과 공고 세 줄만 남겨야 "공고 목록"으로 읽힌다.

  점이 빠져 도형이 작아진 만큼 scale을 0.93으로 다시 잡았다(안전 반지름 33 기준).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.93"
        android:scaleY="0.93"
        android:translateX="17.7"
        android:translateY="16.8">

        <path
            android:pathData="M21,14 H57 A9,9 0 0 1 66,23 V57 A9,9 0 0 1 57,66 H21 A9,9 0 0 1 12,57 V23 A9,9 0 0 1 21,14 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4" />

        <path
            android:pathData="M24,31 H50"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24,40 H54"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24,49 H42"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
    </group>
</vector>
