<?xml version="1.0" encoding="utf-8"?>
<!--
  API 24~25용 런처 아이콘. 이 버전에는 adaptive icon이 없어 앱이 배경·모양까지 직접 그려야 한다.

  밀도별 비트맵(mipmap-hdpi/... .webp) 대신 벡터 하나로 대신한다. `anydpi`는 모든 밀도에
  매칭되고 밀도 한정자보다 우선하므로 이 파일이 전 밀도를 덮는다. API 26+는 더 구체적인
  `mipmap-anydpi-v26`(adaptive icon)이 이겨서 영향받지 않는다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 코발트 라운드 스퀘어 -->
    <path
        android:fillColor="#1E3FA0"
        android:pathData="M26,2 H82 A24,24 0 0 1 106,26 V82 A24,24 0 0 1 82,106 H26 A24,24 0 0 1 2,82 V26 A24,24 0 0 1 26,2 Z" />

    <!-- 브랜드 심볼. 마스킹이 없어 adaptive 버전보다 크게 넣는다. -->
    <group
        android:translateX="14.35"
        android:translateY="15.65">

        <path
            android:pathData="M21,14 H57 A9,9 0 0 1 66,23 V57 A9,9 0 0 1 57,66 H21 A9,9 0 0 1 12,57 V23 A9,9 0 0 1 21,14 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4" />

        <path
            android:pathData="M24,31 H50"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24,40 H54"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
        <path
            android:pathData="M24,49 H42"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />

        <path
            android:pathData="M51,18 A9,9 0 1 0 69,18 A9,9 0 1 0 51,18 Z"
            android:fillColor="#FF7A6E" />
    </group>
</vector>
