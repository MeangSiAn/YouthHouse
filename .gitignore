# --- 빌드 산출물 ---
# 모듈별 build/ 는 각 모듈의 .gitignore(app/.gitignore)가 담당한다.
/build
.gradle
.kotlin
.externalNativeBuild
.cxx
/captures

# --- 비밀값 ---
# 파일 자체를 리포지토리 밖에 두더라도, 실수로 안에 들어왔을 때를 대비해 패턴으로도 막는다.
local.properties
keystore.properties
*.jks
*.keystore
google-services.json

# --- IDE / 에디터 ---
*.iml
# .idea는 통째로 무시한다. 파일 단위로 골라 추적하면 Android Studio가 버전마다 새 파일을
# 만들 때마다 미추적 파일이 늘어나고, 1인 개발이라 공유할 IDE 설정도 없다.
# 빌드에 필요한 것은 전부 Gradle 파일에 있다.
/.idea/

# Claude Code의 개인 설정(권한 허용 목록 등). 공유용은 .claude/settings.json 쪽이다.
.claude/settings.local.json

# --- 로컬 산출물 ---
.DS_Store
*.hprof
*.log
